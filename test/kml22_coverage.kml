      </LookAt>
      <TimeStamp>
        <when>2010-05-28</when>
      </TimeStamp>
      <styleUrl>#m</styleUrl>
      <Style id="folderStyle">
        <PolyStyle>
          <fill>0</fill>
        </PolyStyle>
      </Style>
      <Region>
        <LatLonAltBox>
          <north>1</north>
          <south>0</south>
          <east>1</east>
          <west>0</west>
          <minAltitude>-100</minAltitude>
          <maxAltitude>0</maxAltitude>
          <gx:altitudeMode>clampToSeaFloor</gx:altitudeMode>
        </LatLonAltBox>
      </Region>
      <ExtendedData>
        <Data name="owner">
          <value>B. Author</value>
        </Data>
      </ExtendedData>
      <gx:balloonVisibility>1</gx:balloonVisibility>
    </Folder>
  </Document>
